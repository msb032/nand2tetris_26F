// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    //It is in this order since if the reset is true then it will become zero so it will be the last one completed basically it goes down backwards.

    //Loading the register with the output of the previous run meaning it is either the incremented value, loaded value, or the reseted value
    Register(in=outRes, load=true, out=out, out=outReg);
    //Incrementing the value of the register
    Inc16(in=outReg, out=incReg);
    //Muxing the output of the register with the incremented value based on the inc input
    Mux16(a=outReg, b=incReg, sel=inc, out=incOut);
    //Muxing the output of the previous Mux with the input based on the load input, since the load input could give back the in
    Mux16(a=incOut, b=in, sel=load, out=loadOut);
    //Muxing the output of the previous Mux with the false values based on the reset input, since the reset input could give back false
    Mux16(a=loadOut, b=false, sel=reset, out=outRes);   



}
